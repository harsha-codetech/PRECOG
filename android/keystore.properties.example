# Copy to keystore.properties and fill in. That file is gitignored.
# The review keystore is not distributed; generate your own with:
#   keytool -genkeypair -v -keystore precog-release.jks -alias precog \
#           -keyalg RSA -keysize 2048 -validity 10950
storeFile=precog-release.jks
storePassword=CHANGE_ME
keyAlias=precog
keyPassword=CHANGE_ME
